generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Week {
  id         Int      @id @default(autoincrement())
  season     Int
  weekNumber Int
  seasonType String   @default("regular")
  pollSource String
  isCurrent  Boolean  @default(false)
  picksLocked Boolean @default(false)
  createdAt  DateTime @default(now())
  games      Game[]
  rankings   PollRanking[]

  @@unique([season, weekNumber, seasonType])
}

model PollRanking {
  id      Int    @id @default(autoincrement())
  weekId  Int
  week    Week   @relation(fields: [weekId], references: [id])
  poll    String
  rank    Int
  team    String
  logo    String?
  wins    Int
  losses  Int
  ties    Int    @default(0)

  @@unique([weekId, poll, team])
}

model Game {
  id           Int      @id @default(autoincrement())
  weekId       Int
  week         Week     @relation(fields: [weekId], references: [id])
  cfbdGameId   Int      @unique
  startDate    DateTime
  homeTeam     String
  awayTeam     String
  homeLogo     String?
  awayLogo     String?
  homeRank     Int?
  awayRank     Int?
  spread       Float?
  overUnder    Float?
  oddsProvider String?
  broadcast    String?
  status       String   @default("scheduled")
  homeScore    Int?
  awayScore    Int?
  venueId      Int?
  venueName    String?
  venueCity    String?
  venueState   String?
  latitude     Float?
  longitude    Float?
  updatedAt    DateTime @updatedAt
  picks        Pick[]
  modelPick    ModelPick?
}

model Pick {
  id        Int      @id @default(autoincrement())
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id])
  picker    String
  betType   String
  side      String
  isCorrect Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, picker])
}

model ModelPick {
  id          Int      @id @default(autoincrement())
  gameId      Int      @unique
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  betType     String
  side        String
  probability Float
  tier        String
  lineSpread  Float?
  lineTotal   Float?
  edgeSpread  Float?
  edgeTotal   Float?
  pSpread     Float?
  pTotal      Float?
  projHome    Float?
  projAway    Float?
  isCorrect   Boolean?
  backfilled  Boolean  @default(false)
  seasonGames Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
